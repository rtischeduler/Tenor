e == 200:\n    # return the search predictions\n    search_term_list = json.loads(r.content)["results"]\n    print search_term_list\nelse:\n    # handle a possible error\n    search_term_list = []',suggestions:'# set the apikey and limit the # coming back\napikey = "LIVDSRZULELA"  # test value\nlmt = 5\n\n# partial search\nsearch = "smile"\n\nr = requests.get(\n    "https://g.tenor.com/v1/search_suggestions?key=%s&q=%s&limit=%s" % (apikey, search, lmt))\n\nif r.status_code == 200:\n    # return the search suggestions\n    search_suggestion_list = json.loads(r.content)["results"]\n    print search_suggestion_list\nelse:\n    # handle a possible error\n    search_suggestion_list = []'},Po='// url Async requesting function\nfunction httpGetAsync(theUrl, callback)\n{\n    // create the request object\n    var xmlHttp = new XMLHttpRequest();\n\n    // set the state change callback to capture when the response comes in\n    xmlHttp.onreadystatechange = function()\n    {\n        if (xmlHttp.readyState == 4 && xmlHttp.status == 200)\n        {\n            callback(xmlHttp.responseText);\n        }\n    }\n\n    // open as a GET call, pass in the url and set async = True\n    xmlHttp.open("GET", theUrl, true);\n\n    // call send with no params as they were passed in on the url string\n    xmlHttp.send(null);\n\n    return;\n}',Fo={anonymousid:'<!DOCTYPE html>\n<html>\n<script>\n\n// callback for anonymous id -- for first time users\nfunction tenorCallback_anonid(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    anon_id = response_objects["anon_id"];\n\n    user_anon_id = anon_id;\n    alert(user_anon_id);\n}\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// start the flow\ngrab_data();\n\n<\/script>\n\n<body>\n\n\n</body>\n</html>',trendinggifs:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for trending top 10 GIFs\nfunction tenorCallback_trending(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    top_10_gifs = response_objects["results"];\n\n    // load the GIFs -- for our example we will load the first GIFs preview size (nanogif) and share size (tinygif)\n\n    document.getElementById("preview_gif").src = top_10_gifs[0]["media"][0]["nanogif"]["url"];\n\n    document.getElementById("share_gif").src = top_10_gifs[0]["media"][0]["tinygif"]["url"];\n\n    return;\n\n}\n\n// function to call the trending and category endpoints\nfunction grab_data()\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n    var lmt = 10;\n\n    // get the top 10 trending GIFs (updated through out the day) - using the default locale of en_US\n    var trending_url = "https://g.tenor.com/v1/trending?key=" + apikey + "&limit=" + lmt;\n    httpGetAsync(trending_url,tenorCallback_trending);\n\n\n    // data will be loaded by each call's callback\n    return;\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// start the flow\ngrab_data();\n\n<\/script>\n<style>\n.container {\n    position: relative;\n    text-align: center;\n    color: white;\n}\n.title {\ntext-align: center;\n}\n.centered {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n}\n</style>\n\n<body>\n\n<h2 class="title">GIF loaded - preview image</h2>\n<div class="container">\n<img id="preview_gif" src="" alt="" style="">\n</div>\n\n<h2 class="title">GIF loaded - share image</h2>\n<div class="container">\n<img id="share_gif" src="" alt="" style="">\n</div>\n\n</body>\n</html>`,categories:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for GIF categories\nfunction tenorCallback_categories(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    categories = response_objects["tags"];\n\n    // load the categories - example is for the first category\n\n    // url to load:\n    var imgurl = categories[0]["image"];\n\n    // text to overlay on image:\n    var txt_overlay = categories[0]["name"];\n\n\n    // search to run if user clicks the category\n    var category_search_path = categories[0]["path"];\n\n    document.getElementById("category_gif").src = imgurl\n    document.getElementById("catgif_caption").innerHTML = txt_overlay\n    document.getElementById("cat_link").href = category_search_path\n\n    return;\n}\n\n// function to call the trending and category endpoints\nfunction grab_data()\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n    var lmt = 10;\n\n    // get the current list of categories - using the default locale of en_US\n    var cat_url = "https://g.tenor.com/v1/categories?key=" + apikey;\n\n    httpGetAsync(cat_url,tenorCallback_categories);\n\n    // data will be loaded by each call's callback\n    return;\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// start the flow\ngrab_data();\n\n<\/script>\n<style>\n.container {\n    position: relative;\n    text-align: center;\n    color: white;\n}\n.title {\ntext-align: center;\n}\n.centered {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n}\n</style>\n\n<body>\n\n<h2 class="title">GIF Category</h2>\n<div class="container">\n    <a id="cat_link" href="">\n        <img id="category_gif" src="" alt="" style="">\n        <div id="catgif_caption" class="centered"></div>\n    </a>\n</div>\n\n</body>\n</html>`,search:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for the top 8 GIFs of search\nfunction tenorCallback_search(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    top_10_gifs = response_objects["results"];\n\n    // load the GIFs -- for our example we will load the first GIFs preview size (nanogif) and share size (tinygif)\n\n    document.getElementById("preview_gif").src = top_10_gifs[0]["media"][0]["nanogif"]["url"];\n\n    document.getElementById("share_gif").src = top_10_gifs[0]["media"][0]["tinygif"]["url"];\n\n    return;\n\n}\n\n\n// function to call the search endpoint\nfunction grab_data()\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n    var lmt = 8;\n\n    // test search term\n    var search_term = "excited";\n\n    // using default locale of en_US\n    var search_url = "https://g.tenor.com/v1/search?q=" + search_term + "&key=" +\n            apikey + "&limit=" + lmt;\n\n    httpGetAsync(search_url,tenorCallback_search);\n\n    // data will be loaded by each call's callback\n    return;\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// start the flow\ngrab_data();\n\n<\/script>\n\n<body>\n\n<h2># 1 GIF loaded - preview image</h2>\n<img id="preview_gif" src="" alt="" style="width:220px;height:164px;">\n\n<h2># 1 GIF loaded - share image</h2>\n<img id="share_gif" src="" alt="" style="width:498px;height:372px;">\n\n</body>\n</html>`,registershare:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for share event\nfunction tenorCallback_share(responsetext)\n{\n    // no action is needed in the share callback\n}\n\n\n\n// function to call the register share endpoint\nfunction send_share(search_term,shared_gifs_id)\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n    var lmt = 8;\n\n    // using default locale of EN_US\n    var share_url = "https://g.tenor.com/v1/registershare?id=" + shared_gifs_id + "&key=" + apikey\n        + "&q=" + search_term;\n\n    httpGetAsync(share_url,tenorCallback_share);\n}\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// grab search term from cookies or some other storage\nsearch_term = "excited";\n\n// GIF id from the shared gif\n// shared_gifs_id = gif_json_response_object_from_search[0][“id”]\nshared_gifs_id = 5957952; // example\n\n// send the share notifcation back to Tenor\nsend_share(search_term,shared_gifs_id);\n\nalert("share sent!");\n\n\n<\/script>\n\n<body>\n\n</body>\n</html>`,autocomplete:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for share event\nfunction tenorCallback_autocomplete(responsetext)\n{\n    var response_objects = JSON.parse(responsetext);\n\n    predicted_words = response_objects["results"];\n\n    document.getElementById("ac_1").innerHTML = predicted_words[0];\n    document.getElementById("ac_2").innerHTML = predicted_words[1];\n}\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n//partial search term\npsearch_term = "exc";\n\n// set the apikey and limit\nvar apikey = "LIVDSRZULELA";\nvar lmt = 5;\n\n// using default locale of en_US\nvar autoc_url = "https://g.tenor.com/v1/autocomplete?key=" + apikey + "&q=" + psearch_term\n    + "&limit=" + lmt;\n\n// send autocomplete request\nhttpGetAsync(autoc_url,tenorCallback_autocomplete);\n\n\n<\/script>\n\n<body>\n\n<h2>Partial Search "exc":</h2>\n<h3 id = "ac_1"></h3>\n<h3 id = "ac_2"></h3>\n\n</body>\n</html>`,suggestions:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for search suggestion event\nfunction tenorCallback_searchSuggestion(responsetext)\n{\n    var response_objects = JSON.parse(responsetext);\n\n    predicted_words = response_objects["results"];\n\n    document.getElementById("ac_1").innerHTML = predicted_words[0];\n    document.getElementById("ac_2").innerHTML = predicted_words[1];\n    document.getElementById("ac_3").innerHTML = predicted_words[2];\n    document.getElementById("ac_4").innerHTML = predicted_words[3];\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n//search term\npsearch_term = "excited";\n\n// set the apikey and limit\nvar apikey = "LIVDSRZULELA";\nvar lmt = 5;\n\n// using default locale of en_US\nvar autoc_url = "https://g.tenor.com/v1/search_suggestions?key=" + apikey + "&q=" + psearch_term\n    + "&limit=" + lmt;\n\n// send search suggestion request\nhttpGetAsync(autoc_url,tenorCallback_searchSuggestion);\n\n\n<\/script>\n\n<body>\n\n<h2>Search Suggestion for "excited":</h2>\n<h3 id = "ac_1"></h3>\n<h3 id = "ac_2"></h3>\n<h3 id = "ac_3"></h3>\n<h3 id = "ac_4"></h3>\n\n</body>\n</html>`,gifs:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for the requested gif\nfunction tenorCallback_gifs(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    var gif = response_objects["results"];\n\n    // load the GIFs -- for our example we will load the first GIFs preview size (nanogif) and share size (tinygif)\n\n    document.getElementById("preview_gif").src = gif[0]["media"][0]["nanogif"]["url"];\n\n    document.getElementById("share_gif").src = gif[0]["media"][0]["tinygif"]["url"];\n\n    return;\n\n}\n\n\n// function to call the trending and category endpoints\nfunction grab_data()\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n\n    // GIF id\n    var gif_id = 8776030;\n\n    // using default locale of en_US\n    var search_url = "https://g.tenor.com/v1/gifs?ids=" + gif_id + "&key=" +\n            apikey;\n\n    httpGetAsync(search_url,tenorCallback_gifs);\n\n    // data will be loaded by each call's callback\n    return;\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// start the flow\ngrab_data();\n\n<\/script>\n\n<body>\n\n<h2># 1 GIF loaded - preview image</h2>\n<img id="preview_gif" src="" alt="" style="width:220px;height:164px;">\n\n<h2># 1 GIF loaded - share image</h2>\n<img id="share_gif" src="" alt="" style="width:498px;height:372px;">\n\n</body>\n</html>`,random:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for the random search\nfunction tenorCallback_randomsearch(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    top_10_gifs = response_objects["results"];\n\n    // load the GIFs -- for our example we will load the first GIFs preview size (nanogif) and share size (tinygif)\n\n    document.getElementById("preview_gif").src = top_10_gifs[0]["media"][0]["nanogif"]["url"];\n\n    document.getElementById("share_gif").src = top_10_gifs[0]["media"][0]["tinygif"]["url"];\n\n    return;\n\n}\n\n\n// function to request random gifs for a given search term\nfunction grab_data()\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n    var lmt = 8;\n\n    // test search term\n    var search_term = "excited";\n\n    // using default locale of en_US\n    var search_url = "https://g.tenor.com/v1/random?q=" + search_term + "&key=" +\n            apikey + "&limit=" + lmt;\n\n    httpGetAsync(search_url,tenorCallback_randomsearch);\n\n    // data will be loaded by each call's callback\n    return;\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// start the flow\ngrab_data();\n\n<\/script>\n\n<body>\n\n<h2># 1 GIF loaded - preview image</h2>\n<img id="preview_gif" src="" alt="" style="width:220px;height:164px;">\n\n<h2># 1 GIF loaded - share image</h2>\n<img id="share_gif" src="" alt="" style="width:498px;height:372px;">\n\n</body>\n</html>`,trendingterms:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for GIF categories\nfunction tenorCallback_terms(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    terms = response_objects["results"];\n\n    document.getElementById("res").innerHTML = terms\n\n    return;\n}\n\n// function to call the trending terms\nfunction grab_data()\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n    var lmt = 10;\n\n    // get the current list of trending terms - using the default locale of en_US\n    var cat_url = "https://g.tenor.com/v1/trending_terms?key=" + apikey;\n\n    httpGetAsync(cat_url,tenorCallback_terms);\n\n    // data will be loaded by each call's callback\n    return;\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// start the flow\ngrab_data();\n\n<\/script>\n<style>\n.container {\n    position: relative;\n    text-align: center;\n    color: white;\n}\n.title {\ntext-align: center;\n}\n.centered {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n}\n</style>\n\n<body>\n\n<h2 class="title">Trending Terms</h2>\n<div class="container" id="res">\n</div>\n\n</body>\n</html>`,search_stickers:'<!DOCTYPE html>\n<html>\n<script>\n\n// url Async requesting function\nfunction httpGetAsync(theUrl, callback)\n{\n    // create the request object\n    var xmlHttp = new XMLHttpRequest();\n\n    // set the state change callback to capture when the response comes in\n    xmlHttp.onreadystatechange = function()\n    {\n        if (xmlHttp.readyState == 4 && xmlHttp.status == 200)\n        {\n            callback(xmlHttp.responseText);\n        }\n    }\n\n    // open as a GET call, pass in the url and set async = True\n    xmlHttp.open("GET", theUrl, true);\n\n    // call send with no params as they were passed in on the url string\n    xmlHttp.send(null);\n\n    return;\n}\n\n// callback for the top 10 stickers of search\nfunction tenorCallback_search(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    top_10_stickers = response_objects["results"];\n\n    // load the GIFs -- for our example we will load the first sticker preview size (tinywebp) and share size (webp)\n\n    document.getElementById("preview_sticker").src = top_10_stickers[0]["media"][0]["tinywebp_transparent"]["url"];\n\n    document.getElementById("share_sticker").src = top_10_stickers[0]["media"][0]["webp_transparent"]["url"];\n\n    return;\n\n}\n\n\n// function to call the search endpoint\nfunction grab_data()\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n    var lmt = 10;\n\n    // test search term\n    var search_term = "excited";\n\n    // using default locale of en_US\n    var search_url = "https://g.tenor.com/v1/search?searchfilter=sticker&q=" + search_term + "&key=" +\n            apikey + "&limit=" + lmt;\n\n    httpGetAsync(search_url,tenorCallback_search);\n\n    // data will be loaded by each call\'s callback\n    return;\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// start the flow\ngrab_data();\n\n<\/script>\n\n<body>\n\n<h2># 1 Sticker loaded - preview image</h2>\n<img id="preview_sticker" src="" alt="" style="width:220px;height:164px;">\n\n<h2># 1 Sticker loaded - share image</h2>\n<img id="share_sticker" src="" alt="" style="width:498px;height:372px;">\n\n</body>\n</html>',trending_stickers:'<!DOCTYPE html>\n<html>\n<script>\n\n// url Async requesting function\nfunction httpGetAsync(theUrl, callback)\n{\n    // create the request object\n    var xmlHttp = new XMLHttpRequest();\n\n    // set the state change callback to capture when the response comes in\n    xmlHttp.onreadystatechange = function()\n    {\n        if (xmlHttp.readyState == 4 && xmlHttp.status == 200)\n        {\n            callback(xmlHttp.responseText);\n        }\n    }\n\n    // open as a GET call, pass in the url and set async = True\n    xmlHttp.open("GET", theUrl, true);\n\n    // call send with no params as they were passed in on the url string\n    xmlHttp.send(null);\n\n    return;\n}\n\n// callback for trending top 10 stickers\nfunction tenorCallback_trending(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    top_10_stickers = response_objects["results"];\n\n    // load the stickers -- for our example we will load the first sticker preview size (nanogif_transparent) and share size (tinygif_transparent)\n\n    document.getElementById("preview_sticker").src = top_10_stickers[0]["media"][0]["nanogif_transparent"]["url"];\n\n    document.getElementById("share_sticker").src = top_10_stickers[0]["media"][0]["tinygif_transparent"]["url"];\n\n    return;\n\n}\n\n// function to call the trending and category endpoints\nfunction grab_data()\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n    var lmt = 10;\n\n    // get the top 10 trending stickers (updated throughout the day) - using the default locale of en_US\n    var trending_url = "https://g.tenor.com/v1/trending?searchfilter=sticker&key=" + apikey + "&limit=" + lmt;\n    httpGetAsync(trending_url,tenorCallback_trending);\n\n\n    // data will be loaded by each call\'s callback\n    return;\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// start the flow\ngrab_data();\n\n<\/script>\n<style>\n.container {\n    position: relative;\n    text-align: center;\n    color: white;\n}\n.title {\ntext-align: center;\n}\n.centered {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n}\n</style>\n\n<body>\n\n<h2 class="title">GIF loaded - preview image</h2>\n<div class="container">\n<img id="preview_sticker" src="" alt="" style="">\n</div>\n\n<h2 class="title">GIF loaded - share image</h2>\n<div class="container">\n<img id="share_sticker" src="" alt="" style="">\n</div>\n\n</body>\n</html>'},Do={launch:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for trending top 10 GIFs\nfunction tenorCallback_trending(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    top_10_gifs = response_objects["results"];\n\n    // load the GIFs -- for our example we will load the first GIFs preview size (nanogif) and share size (tinygif)\n\n    document.getElementById("preview_gif").src = top_10_gifs[0]["media"][0]["nanogif"]["url"];\n\n    document.getElementById("share_gif").src = top_10_gifs[0]["media"][0]["tinygif"]["url"];\n\n    return;\n\n}\n\n// callback for GIF categories\nfunction tenorCallback_categories(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    categories = response_objects["tags"];\n\n    // load the categories - example is for the first category\n\n    // url to load:\n    var imgurl = categories[0]["image"];\n\n    // text to overlay on image:\n    var txt_overlay = categories[0]["name"];\n\n\n    // search to run if user clicks the category\n    var category_search_path = categories[0]["path"];\n\n    document.getElementById("category_gif").src = imgurl\n    document.getElementById("catgif_caption").innerHTML = txt_overlay\n    document.getElementById("cat_link").href = category_search_path\n\n    return;\n}\n\n// function to call the trending and category endpoints\nfunction grab_data()\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n    var lmt = 10;\n\n    // get the top 10 trending GIFs (updated through out the day) - using the default locale of en_US\n    var trending_url = "https://g.tenor.com/v1/trending?key=" + apikey + "&limit=" + lmt;\n\n\n    httpGetAsync(trending_url,tenorCallback_trending);\n\n    // get the current list of categories - using the default locale of en_US\n    var cat_url = "https://g.tenor.com/v1/categories?key=" + apikey;\n\n    httpGetAsync(cat_url,tenorCallback_categories);\n\n    // data will be loaded by each call's callback\n    return;\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// start the flow\ngrab_data();\n\n<\/script>\n<style>\n.container {\n    position: relative;\n    text-align: center;\n    color: white;\n}\n.title {\ntext-align: center;\n}\n.centered {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n}\n</style>\n\n<body>\n\n<h2 class="title">GIF loaded - preview image</h2>\n<div class="container">\n<img id="preview_gif" src="" alt="" style="">\n</div>\n\n<h2 class="title">GIF loaded - share image</h2>\n<div class="container">\n<img id="share_gif" src="" alt="" style="">\n</div>\n\n<h2 class="title">GIF Category</h2>\n<div class="container">\n    <a id="cat_link" href="">\n        <img id="category_gif" src="" alt="" style="">\n        <div id="catgif_caption" class="centered"></div>\n    </a>\n</div>\n\n</body>\n</html>`,search:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for the top 8 GIFs of search\nfunction tenorCallback_search(responsetext)\n{\n    // parse the json response\n    var response_objects = JSON.parse(responsetext);\n\n    top_10_gifs = response_objects["results"];\n\n    // load the GIFs -- for our example we will load the first GIFs preview size (nanogif) and share size (tinygif)\n\n    document.getElementById("preview_gif").src = top_10_gifs[0]["media"][0]["nanogif"]["url"];\n\n    document.getElementById("share_gif").src = top_10_gifs[0]["media"][0]["tinygif"]["url"];\n\n    return;\n\n}\n\n\n// function to call the trending and category endpoints\nfunction grab_data()\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n    var lmt = 8;\n\n    // test search term\n    var search_term = "excited";\n\n    // using default locale of en_US\n    var search_url = "https://g.tenor.com/v1/search?q=" + search_term + "&key=" +\n            apikey + "&limit=" + lmt;\n\n    httpGetAsync(search_url,tenorCallback_search);\n\n    // data will be loaded by each call's callback\n    return;\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// start the flow\ngrab_data();\n\n<\/script>\n\n<body>\n\n<h2># 1 GIF loaded - preview image</h2>\n<img id="preview_gif" src="" alt="" style="width:220px;height:164px;">\n\n<h2># 1 GIF loaded - share image</h2>\n<img id="share_gif" src="" alt="" style="width:498px;height:372px;">\n\n</body>\n</html>`,registershare:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for share event\nfunction tenorCallback_share(responsetext)\n{\n    // no action is needed in the share callback\n}\n\n\n// function to call the register share endpoint\nfunction send_share(search_term,shared_gifs_id)\n{\n    // set the apikey and limit\n    var apikey = "LIVDSRZULELA";\n    var lmt = 8;\n\n    var share_url = "https://g.tenor.com/v1/registershare?id=" + shared_gifs_id + "&key=" + apikey\n        + "&q=" + search_term;\n\n    httpGetAsync(share_url,tenorCallback_share);\n}\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n// grab search term from cookies or some other storage\nsearch_term = "excited";\n\n// GIF id from the shared gif\n// shared_gifs_id = gif_json_response_object_from_search[0][“id”]\nshared_gifs_id = 5957952; // example\n\n// send the share notifcation back to Tenor\nsend_share(search_term,shared_gifs_id);\n\nalert("share sent!");\n\n\n<\/script>\n\n<body>\n\n</body>\n</html>`,autocomplete:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for share event\nfunction tenorCallback_autocomplete(responsetext)\n{\n    var response_objects = JSON.parse(responsetext);\n\n    predicted_words = response_objects["results"];\n\n    document.getElementById("ac_1").innerHTML = predicted_words[0];\n    document.getElementById("ac_2").innerHTML = predicted_words[1];\n}\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n//partial search term\npsearch_term = "exc";\n\n// set the apikey and limit\nvar apikey = "LIVDSRZULELA";\nvar lmt = 5;\n\n// using default locale of en_US\nvar autoc_url = "https://g.tenor.com/v1/autocomplete?key=" + apikey + "&q=" + psearch_term\n    + "&limit=" + lmt;\n\n// send autocomplete request\nhttpGetAsync(autoc_url,tenorCallback_autocomplete);\n\n\n<\/script>\n\n<body>\n\n<h2>Partial Search "exc":</h2>\n<h3 id = "ac_1"></h3>\n<h3 id = "ac_2"></h3>\n\n</body>\n</html>`,suggestions:`<!DOCTYPE html>\n<html>\n<script>\n\n${Po}\n\n// callback for share event\nfunction tenorCallback_searchSuggestion(responsetext)\n{\n    var response_objects = JSON.parse(responsetext);\n\n    predicted_words = response_objects["results"];\n\n    document.getElementById("ac_1").innerHTML = predicted_words[0];\n    document.getElementById("ac_2").innerHTML = predicted_words[1];\n    document.getElementById("ac_3").innerHTML = predicted_words[2];\n    document.getElementById("ac_4").innerHTML = predicted_words[3];\n}\n\n\n// SUPPORT FUNCTIONS ABOVE\n// MAIN BELOW\n\n//search term\npsearch_term = "smile";\n\n// set the apikey and limit\nvar apikey = "LIVDSRZULELA";\nvar lmt = 5;\n\n// using default locale of en_US\nvar autoc_url = "https://g.tenor.com/v1/search_suggestions?key=" + apikey + "&q=" + psearch_term\n    + "&limit=" + lmt;\n\n// send search suggestion request\nhttpGetAsync(autoc_url,tenorCallback_searchSuggestion);\n\n\n<\/script>\n\n<body>\n\n<h2>Search Suggestion for "smile":</h2>\n<h3 id = "ac_1"></h3>\n<h3 id = "ac_2"></h3>\n<h3 id = "ac_3"></h3>\n<h3 id = "ac_4"></h3>\n\n</body>\n</html>`},qo={anonymousid:'import android.app.Application;\n\nimport org.json.JSONException;\nimport org.json.JSONObject;\n\nimport java.io.BufferedInputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.io.InputStreamReader;\nimport java.io.StringWriter;\nimport java.net.ConnectException;\nimport java.net.HttpURLConnection;\nimport java.net.URL;\n\npublic class App extends Application {\n\n    private static final String API_KEY = "LIVDSRZULELA";\n    private static final String LogTag = "TenorTest";\n\n    @Override\n    public void onCreate() {\n        super.onCreate();\n\n        new Thread() {\n            @Override\n            public void run() {\n\n                // check if there is an anonymous ID already stored\n                SharedPreferences mPrefs = getSharedPreferences("tenor", 0);\n                String anonId = mPrefs.getString("anonymousId","");\n\n                if(anonId == "") // first time user, so get an anonymous ID for them and store it for later use\n                {\n                    anonId = getAnonId();\n                    SharedPreferences.Editor mEditor = mPrefs.edit();\n                    mEditor.putString("anonymousId", anonId).commit();\n                }\n            }\n        }.start();\n    }\n\n    /**\n     * Get anon id\n     */\n    public static String getAnonId() {\n        final String url = String.format("https://g.tenor.com/v1/anonid?key=%s", API_KEY);\n        try {\n            JSONObject response = get(url);\n            return response.getString("anon_id");\n        } catch (IOException | JSONException ignored) {\n        }\n        return "";\n    }\n\n    /**\n     * Construct and run a GET request\n     */\n    private static JSONObject get(String url) throws IOException, JSONException {\n        HttpURLConnection connection = null;\n        try {\n            // Get request\n            connection = (HttpURLConnection) new URL(url).openConnection();\n            connection.setDoInput(true);\n            connection.setDoOutput(true);\n            connection.setRequestMethod("GET");\n            connection.setRequestProperty("Content-Type", "application/json");\n            connection.setRequestProperty("Accept", "application/json");\n            connection.setRequestProperty("Content-Type", "application/json; charSet=UTF-8");\n\n            // Handle failure\n            int statusCode = connection.getResponseCode();\n            if (statusCode != HttpURLConnection.HTTP_OK && statusCode != HttpURLConnection.HTTP_CREATED) {\n                String error = String.format("HTTP Code: \'%1$s\' from \'%2$s\'", statusCode, url);\n                throw new ConnectException(error);\n            }\n\n            // Parse response\n            return parser(connection);\n        } catch (Exception ignored) {\n        } finally {\n            if (connection != null) {\n                connection.disconnect();\n            }\n        }\n        return new JSONObject("");\n    }\n\n    /**\n     * Parse the response into JSONObject\n     */\n    private static JSONObject parser(HttpURLConnection connection) throws JSONException {\n        char[] buffer = new char[1024 * 4];\n        int n;\n        InputStream stream = null;\n        try {\n            stream = new BufferedInputStream(connection.getInputStream());\n            InputStreamReader reader = new InputStreamReader(stream, "UTF-8");\n            StringWriter writer = new StringWriter();\n            while (-1 != (n = reader.read(buffer))) {\n                writer.write(buffer, 0, n);\n            }\n            return new JSONObject(writer.toString());\n        } catch (IOException ignored) {\n   