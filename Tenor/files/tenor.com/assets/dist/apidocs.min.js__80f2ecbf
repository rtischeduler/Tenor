gifs = json.loads(r.content)\n    print gifs\nelse:\n    gifs = None',random:'# set the apikey and limit\napikey = "LIVDSRZULELA"  # test value\nlmt = 8\n\n# our test search\nsearch_term = "excited"\n\n# get random results using default locale of EN_US\nr = requests.get(\n    "https://g.tenor.com/v1/random?q=%s&key=%s&limit=%s" % (search_term, apikey, lmt))\n\nif r.status_code == 200:\n    gifs = json.loads(r.content)\n    print gifs\nelse:\n    gifs = None',trendingterms:'import requests\nimport json\n\n\n# set the apikey and limit\napikey = "LIVDSRZULELA"\n\n# get the current list of categories - using the default locale of en_US\nr = requests.get("https://g.tenor.com/v1/trending_terms?key=%s" % (apikey,))\n\nif r.status_code == 200:\n    trending_terms = json.loads(r.content)\nelse:\n    trending_terms = None\n\n# load the results\nprint trending_terms',search_stickers:"# set the apikey and limit\napikey = \"LIVDSRZULELA\"  # test value\nlmt = 10\n\n# our test search\nsearch_term = \"excited\"\n\n# get the top 8 GIFs for the search term using default locale of EN_US\nr = requests.get(\n    \"https://g.tenor.com/v1/search?searchfilter=sticker&q=%s&key=%s&limit=%s\" % (search_term, apikey, lmt))\n\nif r.status_code == 200:\n    # load the GIFs using the urls for the smaller GIF sizes\n    top_10stickers = json.loads(r.content)\n    print top_10stickers\n    # print the first webp_transparent sticker asset\n    print top_10stickers['results'][0]['media'][0]['webp_transparent']['url']\nelse:\n    top_10stickers = None",trending_stickers:'import requests\nimport json\n\n# set the apikey and limit\napikey = "LIVDSRZULELA"\nlmt = 10\n\n\n# get the top 10 trending GIFs - using the default locale of en_US\nr = requests.get("https://g.tenor.com/v1/trending?searchfilter=sticker&key=%s&limit=%s" % (apikey, lmt))\n\nif r.status_code == 200:\n    trending_stickers = json.loads(r.content)\nelse:\n    trending_stickers = None\n\n# load the results\nprint trending_stickers'},jo={